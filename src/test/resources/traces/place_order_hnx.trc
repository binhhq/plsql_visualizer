CLOSE #281473559048544:c=4,e=4,dep=2,type=0,tim=1785407756793167
=====================
PARSING IN CURSOR #281473559048544 len=855 dep=2 uid=0 oct=3 lid=0 tim=1785407756793498 hv=3579389471 ad='7931ff28' sqlid='b3hjnmgapk9hz'
select count(*) num_avs
from (
select s.owner src_owner, s.name src_name, av.obj# av#
from hcs_analytic_view$ av, hcs_src$ s
where av.obj# = s.hcs_obj# and
  av.qry_xform_enabled = 1 and av.qry_xform_rely = 1
union
select ds.owner src_owner, ds.name src_name, av.obj# av#
from hcs_analytic_view$ av, hcs_av_dim$ avd, hcs_dim$ d,
  "_ACTUAL_EDITION_OBJ" do, user$ du, hcs_src$ ds
where
  av.obj# = avd.av# and
  d.obj# = ds.hcs_obj# and
  d.obj# = do.obj# and
  do.name = avd.dim_name and
  do.namespace = 135 and
  do.owner# = du.user# and
  avd.dim_owner = du.name and
  d.container_obj# = d.obj# and
  ds.container_obj# = ds.hcs_obj# and
  av.qry_xform_enabled = 1 and av.qry_xform_rely = 1
) tabs, "_ACTUAL_EDITION_OBJ" o, user$ u
where
  o.obj# = tabs.av# and
  o.namespace = 1 and
  o.status not in (2,3) and
  o.owner# = u.user# and
  src_owner = :1
END OF STMT
